{
  "openapi": "3.0.3",
  "info": {
    "title": "T-Hub API",
    "description": "REST API for T-Hub - Thesaurus Hub for Software Components",
    "version": "1.0.0",
    "contact": {
      "name": "T-Hub Team",
      "email": "team@thub.io",
      "url": "https://thub.io"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.thub.io",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "components",
      "description": "Component management operations"
    },
    {
      "name": "search",
      "description": "Search and discovery"
    },
    {
      "name": "dependencies",
      "description": "Dependency resolution"
    },
    {
      "name": "stats",
      "description": "Statistics and analytics"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "uptime": { "type": "number" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/components": {
      "get": {
        "summary": "List components",
        "tags": ["components"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by category"
          },
          {
            "name": "language",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by programming language"
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Search query"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 },
            "description": "Number of results per page"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": { "type": "integer", "default": 0 },
            "description": "Pagination offset"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentList"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new component",
        "tags": ["components"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComponentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Component created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Component"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/components/{id}": {
      "get": {
        "summary": "Get component by ID",
        "tags": ["components"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ComponentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentDetailed"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "summary": "Update component",
        "tags": ["components"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ComponentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComponentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Component updated"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Delete component",
        "tags": ["components"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ComponentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Component deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/components/{id}/download": {
      "get": {
        "summary": "Download component",
        "tags": ["components"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ComponentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Component file",
            "content": {
              "application/javascript": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "summary": "Search components",
        "tags": ["search"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Search query"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": { "type": "string" },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Component"
                      }
                    },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Get platform statistics",
        "tags": ["stats"],
        "responses": {
          "200": {
            "description": "Statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trending": {
      "get": {
        "summary": "Get trending components",
        "tags": ["stats"],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["day", "week", "month"],
              "default": "week"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "Trending components"
          }
        }
      }
    },
    "/api/v1/resolve": {
      "post": {
        "summary": "Resolve component dependencies",
        "tags": ["dependencies"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string" },
                        "version": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved dependencies"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Component": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "content_hash": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "language": { "type": "string" },
          "license": { "type": "string" },
          "downloads": { "type": "integer" },
          "stars": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ComponentDetailed": {
        "allOf": [
          { "$ref": "#/components/schemas/Component" },
          {
            "type": "object",
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "version": { "type": "string" }
                  }
                }
              },
              "exports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "signature": { "type": "string" }
                  }
                }
              },
              "quality": {
                "type": "object",
                "properties": {
                  "testCoverage": { "type": "number" },
                  "securityScore": { "type": "integer" },
                  "maintainability": { "type": "string" }
                }
              }
            }
          }
        ]
      },
      "ComponentInput": {
        "type": "object",
        "required": ["name", "version", "code"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "language": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "ComponentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Component" }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "limit": { "type": "integer" },
              "offset": { "type": "integer" },
              "hasMore": { "type": "boolean" }
            }
          }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "totalComponents": { "type": "integer" },
          "totalDownloads": { "type": "integer" },
          "totalStars": { "type": "integer" },
          "categories": { "type": "object" },
          "languages": { "type": "object" }
        }
      }
    },
    "parameters": {
      "ComponentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Component ID"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string" }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
