# T-Hub Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thub
DB_USER=thub
DB_PASSWORD=thub_password

# Alternative: Use DATABASE_URL for connection string
# DATABASE_URL=postgres://thub:thub_password@localhost:5432/thub

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# MinIO/S3 Storage (optional)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=thub-components

# API Settings
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# Feature Flags
RUN_MIGRATIONS=true
ENABLE_METRICS=true

# External Services (optional)
SNYK_TOKEN=
GITHUB_TOKEN=
