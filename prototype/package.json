{
  "name": "@thub/core",
  "version": "0.1.0",
  "description": "T-Hub: Thesaurus Hub for Software Components",
  "main": "index.js",
  "bin": {
    "thub": "./cli/index.js"
  },
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "db:migrate": "node -e \"require('./db').getDatabase().migrate().then(() => process.exit(0))\"",
    "db:seed": "node -e \"require('./db').getDatabase().seed('./db/seeds/001_sample_data.sql').then(() => process.exit(0))\"",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/*.integration.test.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "thub",
    "components",
    "registry",
    "deduplication",
    "microservices"
  ],
  "author": "T-Hub Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "aws-sdk": "^2.1400.0",
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.5",
    "axios": "^1.4.0",
    "semver": "^7.5.4",
    "dotenv": "^16.3.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "winston": "^3.10.0",
    "joi": "^17.9.2",
    "swagger-ui-express": "^5.0.0",
    "@elastic/elasticsearch": "^8.10.0",
    "prom-client": "^15.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
